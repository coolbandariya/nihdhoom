# Browser-safe values (Vite exposes VITE_* variables to the browser)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI
# Groq is supported as the primary Sathi provider when configured.
GROQ_API_KEY=
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# OpenAI remains a compatible fallback/provider option.
OPENAI_API_KEY=
NIRDHOOM_AI_MODEL=
REQUIRE_AUTH_FOR_AI=true

# Dispatch and remote sensing
DISPATCH_SERVICE_URL=
DISPATCH_SERVICE_TOKEN=
FIRMS_MAP_KEY=
REQUIRE_AUTH_FOR_FIRMS=true

# Payments intentionally disabled in this release. Do not add provider credentials.

# Telegram is the primary farmer messaging channel for this release.
# TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET are server-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_URL=
# Public HTTPS site URL; bot buttons open the matching NIRDHOOM page.
NIRDHOOM_PUBLIC_URL=
VITE_TELEGRAM_BOT_USERNAME=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
IVR_WEBHOOK_URL=
IVR_PROVIDER_TOKEN=

# Sentinel Hub (only if the ingestion service is implemented)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# Demo mode is opt-in. Keep false/empty for production/live-data surfaces.
VITE_NIRDHOOM_DEMO_MODE=false

# Provider integrations
WEATHER_PROVIDER=open-meteo
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=
CADASTRAL_PROVIDER=punjab-bhunaksha

# React Bits Pro registry (local CLI only; never expose the license key to Vite)
REACTBITS_LICENSE_KEY=
